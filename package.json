{
  "name": "saidvsdid",
  "version": "0.2.0",
  "description": "What your coding agent did with the tests: detects deleted, skipped, focused or weakened tests and test-configuration changes in a pull request, as one PR comment (GitHub Action) or a CLI report.",
  "license": "MIT",
  "author": "Jorge Díaz (https://github.com/JorgeAV99)",
  "type": "module",
  "bin": {
    "saidvsdid": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/action",
    "python",
    "grammars",
    "README.md",
    "LICENSE",
    "docs/rules.md",
    "docs/known-limitations.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JorgeAV99/saidvsdid.git"
  },
  "homepage": "https://github.com/JorgeAV99/saidvsdid#readme",
  "bugs": {
    "url": "https://github.com/JorgeAV99/saidvsdid/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "coding-agents",
    "testing",
    "test-integrity",
    "test-tampering",
    "code-review",
    "pull-request",
    "github-action",
    "vitest",
    "jest",
    "playwright",
    "pytest",
    "claude-code",
    "codex",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:action": "node scripts/build-action.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fixtures": "tsx fixtures/build.ts",
    "vendor:grammars": "node scripts/vendor-grammars.mjs",
    "prepack": "npm run build",
    "fixtures:runner": "node scripts/runner-evidence.mjs"
  },
  "dependencies": {
    "typescript": "5.9.3",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/commonmark": "0.27.10",
    "@types/node": "^20.19.0",
    "@types/picomatch": "4.0.3",
    "commonmark": "0.31.2",
    "esbuild": "0.28.2",
    "jest": "30.5.2",
    "picomatch": "4.0.7",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11",
    "yaml": "2.9.1"
  }
}
